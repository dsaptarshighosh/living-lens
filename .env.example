# Required: generate a unique secret of at least 32 random bytes.
LIVING_LENS_SECRET=replace-with-a-long-random-secret
LIVING_LENS_HOST=127.0.0.1
LIVING_LENS_PORT=8000
# Optional path; defaults to living_lens.sqlite3 next to server.py
LIVING_LENS_DB=./living_lens.sqlite3
# Optional. Set only after reviewing the dataset's target units and risk rules.
# No alert threshold is enabled by default.
# LIVING_LENS_ALERT_THRESHOLD=

# Optional email notification provider (SMTP)
# LIVING_LENS_SMTP_HOST=
# LIVING_LENS_SMTP_PORT=587
# LIVING_LENS_SMTP_USERNAME=
# LIVING_LENS_SMTP_PASSWORD=
# LIVING_LENS_SMTP_FROM=
# Optional SMS provider (Twilio)
# LIVING_LENS_TWILIO_ACCOUNT_SID=
# LIVING_LENS_TWILIO_AUTH_TOKEN=
# LIVING_LENS_TWILIO_FROM=
